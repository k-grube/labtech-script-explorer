{
  "name": "labtech-script-explorer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "React app that decodes and displays LabTech / ConnectWise Automate scripts",
  "homepage": "https://k-grube.github.io/labtech-script-explorer",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "npm run build && gh-pages -d dist",
    "prepare": "husky || true",
    "format": "prettier --write .",
    "lint": "npm run format && eslint .",
    "lint:check": "eslint .",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/material": "7.3.11",
    "@mui/x-tree-view": "9.10.0",
    "labtech-script-decode": "1.0.1",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "9.1.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "gh-pages": "6.3.0",
    "husky": "9.1.7",
    "jsdom": "26.1.0",
    "prettier": "3.9.5",
    "vite": "7.3.6",
    "vite-plugin-node-polyfills": "0.28.0",
    "vitest": "5.0.0"
  }
}
